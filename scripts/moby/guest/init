#!/bin/sh
# Persistent ext4 stage-2 PID1: dockerd never runs from initramfs.
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022
log() { echo "[kiri-moby-init] $*" >&2; }
die() { log "FATAL: $*"; exec /bin/sh; }
[ "$#" -eq 1 ] && [ "$1" = --ext4-root ] ||
    die "refusing to run Docker Engine outside real ext4 root"

# STAGE 2: PID 1 after switch_root. Verify the root mount.
root_mount="$(awk '$5 == "/" { print; exit }' /proc/self/mountinfo)"
case "$root_mount" in
    *" - ext4 "*)
        log "Stage 2: ext4 root verified (runc pivot_root compatible)" ;;
    *" - btrfs "*)
        # Btrfs data disk: the docker subvolume is the running root. Same
        # pivot_root compatibility as ext4 (a real mountable filesystem).
        log "Stage 2: btrfs docker subvolume verified as root" ;;
    *) die "Stage 2 root is neither ext4 nor btrfs: $root_mount" ;;
esac
log "Guest build: $(/usr/local/sbin/kiri-moby-guest --version 2>&1)"
mkdir -p /dev/pts /dev/shm /sys/fs/cgroup /run /tmp /var/lib /mnt/mac /Users /Volumes
mount -t devpts devpts /dev/pts || die "mount devpts"
mount -t tmpfs tmpfs /dev/shm || die "mount /dev/shm"
mount -t tmpfs tmpfs /run || die "mount /run"
mount -t tmpfs tmpfs /tmp || die "mount /tmp"
mount -t cgroup2 cgroup2 /sys/fs/cgroup || die "mount cgroup v2"
# Data disk: stage 1 already mounted the btrfs (label kiri-moby) and bind-
# mounted it at /mnt/data, with the docker subvolume as the running root.
# Verify the layout; legacy ext4 boots simply have no /mnt/data mount.
if mount | grep -q " on /mnt/data "; then
    for sub in docker machines k8s; do
        [ -d "/mnt/data/$sub" ] || die "btrfs data disk missing subvolume: $sub"
    done
    log "Data disk: btrfs with docker/machines/k8s subvolumes"
    mkdir -p /mnt/data/docker/var/lib/docker /mnt/data/docker/var/lib/containerd
    mount --bind /mnt/data/docker/var/lib/docker /var/lib/docker ||
        die "docker state bind failed"
else
    log "Data disk: legacy ext4 layout (no btrfs subvolumes)"
fi
# Evict cold dentry/inode caches a little more readily while leaving the
# useful Docker image/build page cache alone. Does not promise macOS RSS drop.
printf '%s\n' 160 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true

# The Apple VZ guest RTC may initially be 1970. Sync BEFORE dockerd.
boot_epoch=""
idle_drop_caches=0
hvf_rosetta=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        kiri.moby_boot_time=*) boot_epoch="${arg#*=}" ;;
        kiri.moby_idle_drop_caches=1) idle_drop_caches=1 ;;
        kiri.moby_hvf_rosetta=1) hvf_rosetta=1 ;;
    esac
done
case "$boot_epoch" in
    ''|*[!0-9]*) die "Invalid/missing Mac boot epoch" ;;
esac
log "Synchronizing CLOCK_REALTIME from Mac epoch=$boot_epoch"
/usr/local/sbin/kiri-moby-guest --set-clock "$boot_epoch" ||
    die "Guest time synchronization failed"
log "Guest clock: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
[ "$(date -u '+%s')" -ge 1700000000 ] || die "Guest clock remains invalid"

hostname kiri-moby
echo kiri-moby >/etc/hostname
mkdir -p /var/lib/docker /var/lib/containerd /run/containerd /run/docker /var/log
# Explicit project shares use hex-coded mount mappings from the trusted
# Mac launcher; legacy full /Users and /Volumes access requires an explicit
# KIRI_MOBY_SHARE_MAC=1 opt-in on the Host.
# Two share layouts are understood:
#   * default (shipping VZ Helper): one 'kiri-mac' VirtioFS tag whose root
#     already contains s0, s1, ... subdirectories (VZMultipleDirectoryShare).
#   * kiri.moby_share_layout=per-directory (in-process HVF/libkrun opt-in):
#     the launcher registers one VirtioFS tag per approved share, named
#     kiri-s0, kiri-s1, ... Mount every tag at <mac_root>/sN so the
#     unchanged Rust --mount-shares decoder validates the hex spec and
#     binds each slot to its exact authorized Guest path. Without the
#     cmdline option the original VZ path behaves exactly as before.
share_spec=""
share_layout=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        kiri.moby_shares=*) share_spec="${arg#*=}" ;;
        kiri.moby_share_layout=*) share_layout="${arg#*=}" ;;
    esac
done
# --- kiri-share-layout begin (extracted by test-share-layout.sh) ---
# KIRI_MOBY_MAC_MOUNT and KIRI_MOBY_GUEST_BIN are test seams; production
# launchers set neither, so the defaults below are the only real values.
mac_root="${KIRI_MOBY_MAC_MOUNT:-/mnt/mac}"
guest_bin="${KIRI_MOBY_GUEST_BIN:-/usr/local/sbin/kiri-moby-guest}"
case "$share_layout" in
per-directory)
    if [ -z "$share_spec" ]; then
        log "Mac host file shares disabled"
    else
        # Count comma-separated spec entries. The trusted launcher emits
        # only [A-Za-z0-9@,.] here, and never more than 16 slots: the same
        # MAX_SHARES bound the Rust decoder enforces. A malformed spec
        # still reaches Rust, which rejects it regardless of this count.
        slots=0
        rest="$share_spec"
        while [ -n "$rest" ]; do
            slots=$((slots + 1))
            [ "$slots" -le 16 ] ||
                die "per-directory share layout: too many share entries"
            case "$rest" in *,*) rest="${rest#*,}" ;; *) rest="" ;; esac
        done
        i=0
        while [ "$i" -lt "$slots" ]; do
            mkdir -p "$mac_root/s$i" || die "cannot create $mac_root/s$i"
            # Deliberately NO fallback to a broad kiri-mac mount or the
            # legacy /Users bind: a missing per-share tag means the
            # launcher configured the VM wrong and must fail closed.
            mount -t virtiofs "kiri-s$i" "$mac_root/s$i" ||
                die "VirtioFS per-share mount kiri-s$i failed"
            i=$((i + 1))
        done
        "$guest_bin" --mount-shares "$share_spec" ||
            die "authorized Mac directory mounts failed"
    fi
    ;;
*)
    if mount -t virtiofs kiri-mac "$mac_root"; then
        if [ -n "$share_spec" ]; then
            "$guest_bin" --mount-shares "$share_spec" ||
                die "authorized Mac directory mounts failed"
        else
            [ ! -d "$mac_root/Users" ] ||
                mount --bind "$mac_root/Users" /Users || die "Mac /Users bind failed"
            [ ! -d "$mac_root/Volumes" ] ||
                mount --bind "$mac_root/Volumes" /Volumes || die "Mac /Volumes bind failed"
        fi
    else
        [ -z "$share_spec" ] || die "VirtioFS required for authorized Mac directory shares"
        log "Mac host file shares disabled"
    fi
    ;;
esac
# --- kiri-share-layout end ---
if [ "$hvf_rosetta" = 1 ]; then
    /usr/local/sbin/kiri-rosetta --diagnose || log "Apple Intel translation setup failed in HVF"
elif [ "$share_layout" != per-directory ]; then
    /usr/local/sbin/kiri-rosetta || log "Rosetta not available"
fi

ip link set lo up
ip link set eth0 up || die "guest eth0 missing"
# Debian ships udhcpc only as a BusyBox applet; Alpine had a standalone link.
udhcpc_bin="$(command -v udhcpc || echo /bin/busybox udhcpc)"
$udhcpc_bin -i eth0 -s /usr/local/sbin/kiri-udhcpc -n -q -t 12 || die "guest DHCP failed"
# Fallback DNS: the libslirp NAT forwarder always answers on 10.0.2.2 when the
# DHCP-provided resolver list is empty or malformed.
grep -qs "nameserver" /etc/resolv.conf || echo "nameserver 10.0.2.2" > /etc/resolv.conf

# The launcher injects the pinned Docker Engine binaries read-only under the
# "docker" VirtioFS tag (OrbStack-style app-side engine). It is the only
# engine: the seed ships none, so a missing tag fails closed — an incomplete
# injection is a packaging mistake that must surface, not fall back silently.
mkdir -p /run/docker-host
if mount -t virtiofs docker /run/docker-host 2>/dev/null && [ -x /run/docker-host/bin/dockerd ]; then
    export PATH="/run/docker-host/bin:$PATH"
    log "Using injected Docker Engine from /run/docker-host/bin"
else
    umount /run/docker-host 2>/dev/null || true
    die "Injected Docker Engine tag missing or incomplete (dockerd not found)"
fi
containerd --root /var/lib/containerd --state /run/containerd >/dev/console 2>&1 &
containerd_pid=$!
dockerd --host unix:///run/docker.sock --containerd /run/containerd/containerd.sock \
    --data-root /var/lib/docker --exec-root /run/docker \
    --storage-driver overlay2 --iptables=true --ip6tables=true \
    >/dev/console 2>&1 &
dockerd_pid=$!
KIRI_MOBY_ENGINE_SOCKET=/run/docker.sock /usr/local/sbin/kiri-moby-guest >/dev/console 2>&1 &
bridge_pid=$!

shutdown() {
    trap - TERM INT
    log "Stopping dockerd/containerd and flushing ext4 data"
    [ -z "${idle_cache_worker_pid:-}" ] || kill -TERM "$idle_cache_worker_pid" 2>/dev/null || true
    kill -TERM "$dockerd_pid" "$containerd_pid" "$bridge_pid" 2>/dev/null || true
    n=0
    while kill -0 "$dockerd_pid" 2>/dev/null && [ "$n" -lt 20 ]; do
        sleep 1
        n=$((n + 1))
    done
    sync
    # The root filesystem cannot be unmounted while PID 1 is running.
    mount -o remount,ro / 2>/dev/null || log "ext4 root still busy; journaling handles recovery"
    poweroff -f
}
trap shutdown TERM INT
log "Moby services started on ext4 root"
# Optional A/B experiment: release only CLEAN Linux file cache after the
# last container leaves. This is deliberately NOT the normal memory policy:
# evicting cache on every poll harms Docker builds and may not reduce macOS
# VZ RSS. The worker follows Docker's event stream instead of blind polling:
# each container die/destroy event starts a short quiescence window, and two
# successful container-free Docker queries guard against early startup and
# restart-policy containers. No dirty cache or Docker state is deleted.
idle_cache_worker_pid=""
if [ "$idle_drop_caches" = 1 ]; then
    (
        while kill -0 "$dockerd_pid" 2>/dev/null; do
            # Stream only lifecycle events; a die or destroy of the last
            # running container is the signal that its anonymous pages are
            # gone and only page cache remains to hand back to the balloon.
            events="$(docker --host unix:///run/docker.sock events \
                --filter type=container --filter event=die \
                --filter event=destroy --format '{{.Actor.ID}}' 2>/dev/null | head -1)"
            [ -n "$events" ] || { sleep 5; continue; }
            sleep 5
            kill -0 "$dockerd_pid" 2>/dev/null || exit 0
            running="$(docker --host unix:///run/docker.sock ps -q 2>/dev/null)" || continue
            [ -z "$running" ] || continue
            sleep 5
            kill -0 "$dockerd_pid" 2>/dev/null || exit 0
            running="$(docker --host unix:///run/docker.sock ps -q 2>/dev/null)" || continue
            [ -z "$running" ] || continue
            # Docker may be idle while a Linux Machine or k3s remains active.
            # Skip global cache eviction in that case; probe failure fails closed.
            other_workloads="$(/usr/local/sbin/kiri-moby-guest --non-docker-workloads 2>/dev/null)" || continue
            [ "$other_workloads" = idle ] || continue
            before="$(awk '$1 == "Cached:" { print $2; exit }' /proc/meminfo)"
            if printf '1\n' > /proc/sys/vm/drop_caches; then
                after="$(awk '$1 == "Cached:" { print $2; exit }' /proc/meminfo)"
                log "Memory: file-cache eviction after last container exit, Cached ${before:-?} -> ${after:-?} KiB"
            else
                log "Memory: file-cache eviction unavailable"
            fi
        done
    ) &
    idle_cache_worker_pid="$!"
fi
wait "$dockerd_pid" || log "dockerd exited unexpectedly"
shutdown
