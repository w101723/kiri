+    /// The host peer stopped sending (its write half is gone, e.g. the Docker
+    /// CLI calling CloseWrite() after hijacking an attach/exec connection).
+    /// Report it as a vsock SHUTDOWN(SEND), never as an RST: an RST destroys
+    /// the guest socket and discards everything it has not flushed yet, which
+    /// silently truncates container stdout/PTY output that arrives after the
+    /// host-side stdin half-close.
+    fn push_shutdown_send(&self) {
+        debug!(
+            "push_shutdown_send: id: {}, peer_port: {}, local_port: {}",
+            self.id, self.peer_port, self.local_port
+        );
+
+        let rx = MuxerRx::Shutdown {
+            local_port: self.local_port,
+            peer_port: self.peer_port,
+            flags: uapi::VSOCK_FLAGS_SHUTDOWN_SEND,
+            fwd_cnt: self.tx_cnt.0,
+        };
+
+        push_packet(self.cid, rx, &self.rxq, &self.queue, &self.mem);
+    }
+
+    /// Distinguish a peer half-close (peer write ended, peer still reading)
+    /// from a full close: a zero-byte send succeeds on the former and fails
+    /// with EPIPE/ENOTCONN on the latter.
+    fn peer_can_still_receive(&self) -> bool {
+        let mut buf = [];
+        match send(self.fd.as_raw_fd(), &mut buf, MsgFlags::MSG_DONTWAIT) {
+            Ok(_) => true,
+            Err(e) => {
+                debug!("peer_can_still_receive: id={}, err={e}", self.id);
+                false
+            }
+        }
+    }
+
     fn peer_avail_credit(&self) -> usize {
